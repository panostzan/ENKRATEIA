{
  "manifest_version": 3,
  "name": "ENKRATEIA — deliberate attention",
  "version": "1.0.0",
  "description": "Eight seconds between impulse and intention. A private instrument for focused browsing.",
  "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"}, "minimum_chrome_version": "120",
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "ENKRATEIA"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["shield.js"], "run_at": "document_start"}]
}
